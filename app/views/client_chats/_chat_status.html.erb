<% if chat.status == 'waiting' %>
  <div id="chat-status-<%= chat.visitors_token %>">
    <h2>Чат</h2>
    <p>Ожидаем подключение оператора.....</p>
    
    
      Чат будет доступен с подключением оператора
   
  </div>
<% else %>
  <div id="chat-status-<%= chat.visitors_token %>">
    <h2>Чат</h2>
    
    
      <%= render "shared/send_message_form", 
                 chat: chat,  
                 current_sender: "visitor", 
                 current_goal_url: chat_messages_path(chat.visitors_token) %>
    
  </div>
<% end %>